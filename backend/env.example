# Optional environment overrides for pico-kiosk-backend
# If you do not set these, config.js defaults are used.

# Server
HOST=0.0.0.0
PORT=3000
# PUBLIC_DIR=/app/public

# Source page for rendering
SOURCE_PAGE_PATH=/index.html
# SOURCE_PAGE_URL=http://localhost:3000/index.html

# Display
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480
DISPLAY_THRESHOLD=128

# Puppeteer
PUPPETEER_HEADLESS=new
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
